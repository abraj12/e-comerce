{
  "name": "algions-ecommerce-platform",
  "version": "1.0.0",
  "description": "Secure, Reusable, Component-Based E-commerce Platform for ALGIONS AI LABS",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:concurrency": "tsx --test tests/concurrency/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "tsx --test tests/checkout.e2e.test.ts"
  },
  "keywords": [
    "ecommerce",
    "reusable-components",
    "algions",
    "retail",
    "inventory",
    "casbin",
    "prisma",
    "zod"
  ],
  "author": "ALGIONS AI LABS PRIVATE LIMITED",
  "license": "Apache-2.0",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "casbin": "^5.51.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "razorpay": "^2.9.8",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "prisma": "^6.4.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
