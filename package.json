{
  "name": "algions-ecommerce-platform",
  "version": "1.0.0",
  "description": "Secure, Reusable, Component-Based E-commerce Platform for ALGIONS AI LABS (Next.js Frontend & Express/Prisma Backend)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm --prefix backend start\" \"npm --prefix frontend start\"",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "seed": "npm --prefix backend run prisma:seed",
    "test": "npm --prefix backend test",
    "test:unit": "npm --prefix backend run test:unit",
    "test:security": "npm --prefix backend run test:security",
    "test:concurrency": "npm --prefix backend run test:concurrency",
    "test:integration": "npm --prefix backend run test:integration",
    "test:e2e": "npm --prefix backend run test:e2e"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
