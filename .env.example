# ==============================================================================
# ALGIONS E-Commerce Platform - Environment Variables Template
# Copy this file to .env and configure for your deployment environment.
# DO NOT COMMIT SECRETS OR PASSWORDS TO SOURCE REPOSITORIES.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database Access (SQLite for local dev/testing, PostgreSQL for production clients)
# SQLite example: file:./dev.db
# PostgreSQL example: postgresql://dbuser:securepassword@localhost:5432/algions_store?schema=public
DATABASE_URL=file:./dev.db

# Authentication & Cryptographic Secrets (Minimum 32 random characters in production)
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string-for-jwt
REFRESH_SECRET=replace-with-a-secure-random-32-byte-hex-string-for-refresh
COOKIE_SECRET=replace-with-a-secure-random-32-byte-hex-string-for-cookie

# Payment Gateway (Stripe or Mock Provider)
STRIPE_SECRET_KEY=sk_test_placeholder_for_card_processing
STRIPE_WEBHOOK_SECRET=whsec_placeholder_for_webhook_signature_verification

# Email / SMTP Delivery (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
SMTP_FROM=no-reply@algions-retail.local

# File Upload Storage
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_BYTES=5242880 # 5 MB

# Store Profile & Defaults
STORE_NAME="ALGIONS Retail Mart"
STORE_CURRENCY=INR
STORE_EMAIL=retail@algions.com
STORE_PHONE=+919876543210
TAX_RATE_PERCENTAGE=5.0
LOW_STOCK_DEFAULT_THRESHOLD=5
